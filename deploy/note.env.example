# =============================================================================
# 笔记站后端（note-*）环境变量模板
#
# ⚠️⚠️ 这个文件是【模板】，运行时**不会**被加载！改它不会有任何效果。
#      真正生效的是同目录下的 deploy/note.env.local（去掉 .example 的那个）。
#
# 用法：复制成 note.env.local 再填值。
#   deploy/note.env.local 被 .gitignore 的 *.local 规则忽略，不会误提交。
#
# 谁读它：deploy\note.cmd 启动前读取；也可以手动导入 shell / IDE 运行配置。
# 生效范围：只影响本次启动的 java 进程（设置的是进程级环境变量）。
# =============================================================================

# ---- 数据库 ----
# 库名固定 CipherWS（大小写：Linux 下库名区分大小写，必须与这里一致）
DB_URL=jdbc:mysql://127.0.0.1:3306/CipherWS?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=改成你的数据库密码

# ---- 令牌 ----
# 至少 32 字节。单体后端只需要一个密钥，不再区分 user/core/ai/admin。
# 不设默认值，未配置时服务启动失败。
NOTE_JWT_SECRET=改成一串随机字符至少32位
NOTE_JWT_TTL=2592000

# ---- 头像上传目录 ----
# 相对路径是相对**进程工作目录**，所以强烈建议写绝对路径，
# 否则从不同目录启动时头像会落到不同位置，旧头像 404。
# 留空则用 ./uploads（相对启动时的工作目录）。
# NOTE_UPLOAD_DIR=D:\GraduationProject\note\server\uploads

# ---- 邮件（可选）----
# 这几项也可以单独放在 deploy/mail.env.local 里，启动前一起导入当前 shell。
# 不配就退化成「把验证码写日志」，本地开发照样能跑通找回密码/绑定邮箱。
# SPRING_MAIL_HOST=smtp.qq.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=you@qq.com
# SPRING_MAIL_PASSWORD=邮箱授权码（不是登录密码）
# MAIL_FROM=you@qq.com
# NOTE_MAIL_ENABLED=true
